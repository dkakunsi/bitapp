// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/ubuntu
{
  "name": "bitapp-mobile",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "runArgs": [
    "--privileged",
    "-v",
    "/dev/bus/usb:/dev/bus/usb"
  ],
  "mounts": [
    "source=./.devcontainer/.pub-cache,target=/root/.pub-cache,type=bind",
    "source=./.devcontainer/.docker,target=/var/lib/docker,type=bind"
  ],
  "forwardPorts": [
    8081,
    5037
  ],
  "remoteUser": "root",
  "customizations": {
    "vscode": {
      "extensions": [
        "github.copilot",
        "github.copilot-chat",
        "github.vscode-pull-request-github",
        "vscjava.vscode-gradle",
        "dart-code.dart-code",
        "dart-code.flutter",
        "ms-vscode-remote.remote-containers",
        "sst-dev.opencode",
        "dotjoshjohnson.xml",
        "mhutchie.git-graph",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "java.jdt.ls.java.home": "/opt/.sdkman/candidates/java/current"
      }
    }
  },
  // Features to add to the dev container. More info: https://containers.dev/features.
  // "features": {},
  // Use 'postCreateCommand' to run commands after the container is created.
  // "postCreateCommand": "uname -a",
  // Start Docker daemon and wait for it to be ready
  "postStartCommand": "bash ${containerWorkspaceFolder}/.devcontainer/start-docker.sh"
  // Configure tool-specific properties.
}