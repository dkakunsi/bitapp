{
  "name": "bitapp-mobile",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "runArgs": [
    "--privileged",
    "-v",
    "/dev/bus/usb:/dev/bus/usb"
  ],
  "mounts": [
    "type=volume,source=docker,target=/var/lib/docker",
    "type=volume,source=pub-cache,target=/root/.pub-cache",
    "type=volume,source=android-sdk,target=/opt/android-sdk",
    "type=volume,source=gradle-cache,target=/home/vscode/.gradle",
    "type=volume,source=android-keystore,target=/home/vscode/.android"
  ],
  "forwardPorts": [
    8081,
    5037
  ],
  "remoteUser": "root",
  "customizations": {
    "vscode": {
      "extensions": [
        "github.copilot",
        "github.copilot-chat",
        "github.vscode-pull-request-github",
        "vscjava.vscode-gradle",
        "dart-code.dart-code",
        "dart-code.flutter",
        "ms-vscode-remote.remote-containers",
        "sst-dev.opencode",
        "dotjoshjohnson.xml",
        "mhutchie.git-graph",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "java.jdt.ls.java.home": "/opt/.sdkman/candidates/java/current"
      }
    }
  },
  "postStartCommand": "flutter doctor"
}