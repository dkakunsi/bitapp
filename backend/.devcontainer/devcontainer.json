{
  "name": "bitapp-backend",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "runArgs": [
    "-v",
    "/var/run/docker.sock:/var/run/docker.sock",
    "--add-host=host.docker.internal:host-gateway"
  ],
  "containerEnv": {
    "TESTCONTAINERS_HOST_OVERRIDE": "host.docker.internal"
  },
  "mounts": [
    "type=volume,source=docker,target=/var/lib/docker",
    "type=volume,source=m2,target=/root/.m2",
    "type=bind,source=./.devcontainer/.m2/settings.xml,target=/root/.m2/settings.xml"
  ],
  "forwardPorts": [
    8081,
    5037
  ],
  "remoteUser": "root",
  "customizations": {
    "vscode": {
      "extensions": [
        "github.copilot",
        "github.copilot-chat",
        "github.vscode-pull-request-github",
        "github.vscode-github-actions",
        "redhat.java",
        "vscjava.vscode-java-test",
        "vscjava.vscode-java-dependency",
        "vscjava.vscode-maven",
        "vscjava.vscode-gradle",
        "vscjava.vscode-java-debug",
        "vscjava.vscode-java-pack",
        "ms-vscode-remote.remote-containers",
        "sst-dev.opencode",
        "dotjoshjohnson.xml",
        "mhutchie.git-graph",
        "mongodb.mongodb-vscode",
        "postman.postman-for-vscode",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "java.jdt.ls.java.home": "/opt/.sdkman/candidates/java/current"
      }
    }
  },
  "postStartCommand": "java --version"
}